# Dependencies
node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Electron build output
dist/
out/
release/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables
.env
.env.local
.env.*.local

# Temporary / archives
*.zip
*.tmp
*.temp

# Bundled local-LLM assets (lớn — binary tải lúc build qua scripts/fetch-binaries.js; model đặt thủ công)
bin/
models/
*.gguf

# Claude Code local/session (transient)
.claude/

# Generated test output (sinh bởi scripts/test-translate.js)
scripts/_translate-results.json

# Audio test output (sinh bởi scripts/test-gemini-live.cjs)
*.wav

# File audio thử nghiệm (nặng) — dùng probe live API, không đưa vào repo
extension/mp3-exp/

# Bản build .crx (pack lại được từ extension-single + .pem) — không cần commit
*.crx
# Bỏ qua mọi .pem lạ...
*.pem
# ...NHƯNG CỐ Ý commit extension.pem để đồng bộ khoá ký giữa NHIỀU MÁY (repo PRIVATE).
# ⚠️ BẮT BUỘC GIỮ REPO PRIVATE: khoá này = ai có repo cũng ký được bản cập nhật giả cho extension.
#    Nếu repo lỡ public / rò rỉ → PHẢI đổi khoá (re-key, ID đổi) + mọi người chạy lại apply-policy.bat.
!extension.pem

