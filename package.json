{
  "name": "teams-caption-translator",
  "version": "1.0.0",
  "description": "Đọc Live Captions từ Microsoft Teams qua CDP và dịch sang ngôn ngữ tùy chọn",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "fetch-binaries": "node scripts/fetch-binaries.js",
    "fetch-stt-model": "node scripts/fetch-stt-model.js",
    "prebuild": "node scripts/fetch-binaries.js && node scripts/fetch-stt-model.js",
    "build": "electron-builder"
  },
  "dependencies": {
    "puppeteer-core": "^24.42.0",
    "sherpa-onnx-node": "^1.13.2"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.teamscaptiontranslator",
    "productName": "Caption Translator",
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "src/**",
      "preload.js",
      "app.html",
      "overlay.html",
      "overlay-preload.js",
      "scripts/uia-captions-helper.ps1",
      "node_modules/**/*",
      "!node_modules/puppeteer-core/lib/{esm,es5-iife}/**",
      "!node_modules/chromium-bidi/**",
      "!node_modules/zod/src/**",
      "!node_modules/**/*.{ts,map,md,markdown}",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/{test,tests,__tests__,example,examples,.github,docs,doc}/**"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-*/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*.gguf"
        ]
      }
    ]
  }
}
